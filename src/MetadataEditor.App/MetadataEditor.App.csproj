<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MetadataEditor.Core\MetadataEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\yourtracks.ico</ApplicationIcon>
    <AssemblyTitle>YourTracks</AssemblyTitle>
    <Product>YourTracks</Product>
    <AssemblyName>YourTracks</AssemblyName>
    <RootNamespace>MetadataEditor.App</RootNamespace>
    <Version>0.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>v0.1</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\yourtracks.png" />
    <None Include="Assets\yourtracks.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
