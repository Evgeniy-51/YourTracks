<Window x:Class="MetadataEditor.App.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        Height="230"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.PageBackground}">
    <Border Margin="16" Style="{StaticResource CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="HeadingText"
                           Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="MessageText"
                           Margin="0,8,0,0"
                           Style="{StaticResource MutedText}" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        MinWidth="90"
                        Click="Cancel_Click"
                        IsCancel="True" />
                <Button x:Name="DiscardButton"
                        MinWidth="190"
                        Click="Discard_Click" />
                <Button x:Name="SaveButton"
                        MinWidth="110"
                        Margin="0"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
