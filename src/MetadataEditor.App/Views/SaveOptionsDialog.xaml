<Window x:Class="MetadataEditor.App.Views.SaveOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.PageBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText"
                       Margin="0,0,0,14"
                       Style="{StaticResource SectionTitle}"
                       FontSize="20" />

            <RadioButton x:Name="ModifyOriginalsRadio"
                         GroupName="SaveMode"
                         IsChecked="True" />
            <CheckBox x:Name="CreateBackupsCheck"
                      Margin="24,0,0,14"
                      IsChecked="False" />

            <RadioButton x:Name="CopyToFolderRadio"
                         GroupName="SaveMode" />
            <Grid Margin="24,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationFolderText"
                         IsReadOnly="True" />
                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Click="BrowseDestination_Click" />
                <Button x:Name="NewFolderButton"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Click="NewFolder_Click" />
            </Grid>

            <CheckBox x:Name="ApplyRenameCheck"
                      Margin="0,0,0,10" />
            <TextBlock x:Name="NoteText"
                       Style="{StaticResource MutedText}" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="CancelButton"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button x:Name="SaveButton"
                    MinWidth="110"
                    Style="{StaticResource PrimaryButton}"
                    Click="Save_Click"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
