# Default: normalize text files to LF in the repo.
* text=auto eol=lf

# Source and project files
*.cs              text eol=lf
*.csproj          text eol=lf
*.sln             text eol=lf
*.props           text eol=lf
*.targets         text eol=lf
*.xaml            text eol=lf
*.resx            text eol=lf
*.json            text eol=lf
*.xml             text eol=lf
*.md              text eol=lf
*.txt             text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.editorconfig    text eol=lf
*.gitignore       text eol=lf
*.gitattributes   text eol=lf

# Shell scripts
*.sh              text eol=lf
*.bash            text eol=lf

# Windows scripts keep CRLF
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.ps1             text eol=crlf

# Images and app assets
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.ico             binary
*.svg             text eol=lf
*.webp            binary

# Build and binary artifacts (if ever tracked by mistake)
*.dll             binary
*.exe             binary
*.pdb             binary
*.nupkg           binary
*.snupkg          binary
